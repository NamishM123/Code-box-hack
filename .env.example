# Browser-safe values. Get these from Supabase: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://gffbfzbqmdoewpxsfhao.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server-only. Use only for trusted server jobs; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Copy to .env.local for local dev. Add the same names in Vercel:
# Project -> Settings -> Environment Variables, then redeploy.
#
# Every key is optional. Without them the app runs on the seed catalog
# and the local heuristic room reader, so the whole flow still works.

# --- Vision: room photos + Pinterest vibe reading ---
# https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=

# --- Product search: Amazon, Target, Wayfair, IKEA, Google Shopping ---
# https://serpapi.com/manage-api-key
SERPAPI_KEY=

# --- Facebook Marketplace + Pinterest scraping ---
# https://console.apify.com/settings/integrations
APIFY_TOKEN=
# Optional actor overrides
APIFY_FB_ACTOR=apify~facebook-marketplace-scraper
APIFY_PINTEREST_ACTOR=apify~pinterest-scraper

# --- Pinterest inspiration feed (real photography) ---
# https://unsplash.com/oauth/applications -> your app -> Access Key.
# Without it the Pinterest tab draws its own placeholder feed instead.
UNSPLASH_ACCESS_KEY=

# --- Reading an inspiration picture (Pinterest / Unsplash) ---
# Either key works. OPENAI_API_KEY wins when both are set; VISION_PROVIDER
# pins one explicitly (openai|gemini). Without one, the picture can't be read
# and the shop falls back to generic per-room searches.
OPENAI_VISION_MODEL=gpt-4o-mini
VISION_PROVIDER=
