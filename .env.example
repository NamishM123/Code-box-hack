# Copy to .env.local for local dev. Add the same names in Vercel:
# Project -> Settings -> Environment Variables, then redeploy.
#
# Every key is optional. Without them the app runs on the seed catalog
# and the local heuristic room reader, so the whole flow still works.

# --- Vision: room photos + Pinterest vibe reading ---
# https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=

# --- Product search: Amazon, Target, Wayfair, IKEA, Google Shopping ---
# https://serpapi.com/manage-api-key
SERPAPI_KEY=

# --- Facebook Marketplace + Pinterest scraping ---
# https://console.apify.com/settings/integrations
APIFY_TOKEN=
# Optional actor overrides
APIFY_FB_ACTOR=apify~facebook-marketplace-scraper
APIFY_PINTEREST_ACTOR=apify~pinterest-scraper
